#!/bin/bash

## 初始化环境变量
source /usr/share/deepin-installer/tools/scripts/init_environment.sh
## 导入函数库
source $DI_INSTALL_TOOLS_DIR_ENV/scripts/function_include.sh
## 初始化日志
LOG_FILE="/var/log/deepin-installer/deepin-installer-init.log"
init_log $LOG_FILE

main() {

    ## 启动屏幕管理
    start_screen_manager

    ## 设置显示器从不关闭
    # gsettings set com.deepin.dde.power battery-lid-closed-action 'doNothing'
    # gsettings set com.deepin.dde.power line-power-lid-closed-action 'doNothing'
    # gsettings set com.deepin.dde.power battery-sleep-delay 0

    ## 设置窗管圆角值
    #gsettings set com.deepin.xsettings dtk-window-radius 18 || warning "set window radius failed"
    #curr_win_radius=$(gsettings get com.deepin.xsettings dtk-window-radius)
    #info "curr_win_radius=${curr_win_radius}"

    ## 启动窗管
    setup_kwin
    ## 关闭显示器节能模式
    disable_screensaver
}

main > $LOG_FILE 2>&1
