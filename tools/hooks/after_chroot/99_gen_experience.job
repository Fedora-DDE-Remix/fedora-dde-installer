#!/bin/bash



#导入函数库
#source /usr/share/deepin-installer/tools/scripts/init_environment.sh
source $DI_INSTALL_TOOLS_DIR_ENV/scripts/function_include.sh

echo "DI_INSTALL_TOOLS_DIR_ENV=$DI_INSTALL_TOOLS_DIR_ENV"

get_cpu() {
    # 获取cpu架构
    local cpu=$(uname -m)
    case $cpu in
        "x86_64" | "amd64" | "i386" | "i686")
            cpu="x86"
            ;;
        "aarch64")
            cpu="arm64"
            ;;
        "sw_64")
            cpu="sw"
            ;;
        "mips64")
            cpu="loongson"
            ;;
        "loongarch64")
            cpu="loongson64"
            ;;
    *)
    # Set a default CPU value if the architecture is not recognized
    cpu="unknown"
    ;;
    esac
    echo "$cpu"
}

get_install_type() {
    DI_PARTITION_TYPE=$(installer_get "DI_PARTITION_TYPE")
    install_type=0;
    cryptsetup=false
    save_data=false
    lvmFullDisk=false

    #FullDiskMode
    if [ "$DI_PARTITION_TYPE" = "0" ]; then #FullDiskMode
        install_type=0
    #AdvancedMode
    elif [ "$DI_PARTITION_TYPE" = "1" ]; then
        install_type=2
    #Cryptsetup
    elif [ "$DI_PARTITION_TYPE" = "2" ]; then
        cryptsetup=true
        install_type=0
    #SaveData
    elif [ "$DI_PARTITION_TYPE" = "3" ]; then
        save_data=true
        install_type=0
    #LvmFullDisk7
    elif [ "$DI_PARTITION_TYPE" = "7" ]; then
        install_type=0
        lvmFullDisk=true
    fi
}

get_install_time() {
    DI_RECORD_INSTALL_START=$(installer_get "DI_RECORD_INSTALL_START")

    DI_RECORD_INSTALL_STOP=$(date +"%Y-%m-%d %H:%M:%S")
   
    local start=$(date -d "$DI_RECORD_INSTALL_START" +%s)

    local stop=$(date -d "$DI_RECORD_INSTALL_STOP" +%s)
  
    local difference=$((stop - start))

    local seconds=$((difference % 60))
    local minutes=$((difference / 60 % 60))
    local hours=$((difference / 3600))

    formatted_seconds=$(printf "%02d" $seconds)
    formatted_minutes=$(printf "%02d" $minutes)
    formatted_hours=$(printf "%02d" $hours)

    echo "${formatted_hours}:${formatted_minutes}:${formatted_seconds}"
    
}

get_disk_type() {
    #local output=$(lsblk -lpno PKNAME,MOUNTPOINT |grep  /target |grep -v /usr/lib/live | cut -d " " -f 1)
    local output=$(installer_get "DI_DEVICE_LIST")
    local device_array=$(echo ${output} | tr -s ';' ' ')
    IFS=" " read -ra device_array <<< "${device_array}"
    local unique_array=($(printf "%s\n" ${device_array[@]} | sort -u))

    local disk_type=()
    for dev in "${unique_array[@]}"
    do
        local type=$(lsblk -dno NAME,TRAN $dev |awk '{print $2}')
        disk_type+=($type)
    done
    disk_type=$(echo ${disk_type[@]} | tr -s " "  ",")
    echo $disk_type
}


gen_experience() {
    echo "Generating experience..."

    local experience_dir="/target/etc/deepin"
    local experience_file="${experience_dir}/deepin-user-experience"
    #如果experience_file不存在
    if [ ! -f $experience_file ]; then
        install -Dm644 -v "${DI_CONFIG_DIR_ENV}/settings/deepin-user-experience" "${experience_file}"
    fi

    DI_USER_EXPERIENCE=$(installer_get "DI_USER_EXPERIENCE");
    DI_PRIVACY_POLICY=$(installer_get "DI_PRIVACY_POLICY");
    DI_CRYPT_INFO=$(deepin-installer-config get "/target/${DI_CONFIG_FILE_ENV}" "DI_CRYPT_INFO");

    deepin-installer-config set $experience_file "ExperiencePlan" "ExperienceState" $DI_USER_EXPERIENCE
    #如果DI_CRYPT_INFO为空
    if [ -z "$DI_CRYPT_INFO" ]; then
        deepin-installer-config set $experience_file "ExperiencePlan" "FullDiskEncrypt" "false"
    else
        deepin-installer-config set $experience_file "ExperiencePlan" "FullDiskEncrypt" "true"
    fi

    deepin-installer-config set $experience_file "ExperiencePlan"  "LicenseState" $DI_PRIVACY_POLICY

    # 如果勾选用户体验计划
    if [ $DI_USER_EXPERIENCE = "true" ]; then
        record_file="${experience_dir}/installer_record.json"
        install -Dm644 -v "${DI_CONFIG_DIR_ENV}/settings/installer_record.json" "${record_file}"

        get_install_type
        local json=$(cat $record_file)
        local cpu=$(get_cpu)
        local root_size=$(df /target | awk 'NR==2{print $2}')
        local swap_size=$(swapon --bytes | head -n 2 | awk '/dev/{print $3}')
        if [ -z "$swap_size" ]; then
            swap_size=0
        fi

        local disk_type=$(get_disk_type)
        local init_recovery=$(installer_get "DI_IS_INIT_RECOVERY")
        local installer_version=$(dpkg -s  deepin-installer |grep Version: |awk -F ":" '{print $2}' | tr -d ' ') 
        local install_time=$(get_install_time)

        local updated_json=$(echo "$json" | jq --arg cpu "$cpu" '.CPU = $cpu')

        echo "cpu=$cpu"
        echo "cryptsetup=$cryptsetup"
        echo "disk=$disk_type"
        echo "init_recovery=$init_recovery"
        echo "install_time=$install_time"
        echo "install_type=$install_type"
        echo "installer_version=$installer_version"
        echo "lvmFullDisk=$lvmFullDisk"
        echo "root_size=$root_size"
        echo "save_data=$save_data"
        echo "swap_size=$swap_size"

        if [ $cryptsetup = "true" ]; then
            updated_json=$(echo "$updated_json" | jq --arg  cryptSetup "$cryptsetup" '.cryptSetup = true')
        else
            updated_json=$(echo "$updated_json" | jq --arg  cryptSetup "$cryptsetup" '.cryptSetup = false')
        fi

        updated_json=$(echo "$updated_json" | jq --arg  disk_type  "$disk_type" '.disk = $disk_type')

        if [ $init_recovery = "true" ]; then
            updated_json=$(echo "$updated_json" | jq --arg  init_recovery "$init_recovery" '.initRecovery = true')
        else
            updated_json=$(echo "$updated_json" | jq --arg  init_recovery "$init_recovery" '.initRecovery = false')
        fi

        updated_json=$(echo "$updated_json" | jq --arg  install_time "$install_time" '.installTime = $install_time')

        updated_json=$(echo "$updated_json" | jq --argjson  install_type "$install_type" '.installType = $install_type')

        updated_json=$(echo "$updated_json" | jq --arg  installer_version "$installer_version" '.installerVersion = $installer_version')

        updated_json=$(echo "$updated_json" | jq --arg  installer_version "$installer_version" '.installerVersion = $installer_version')

        if [ $lvmFullDisk = "true" ]; then
            updated_json=$(echo "$updated_json" | jq --arg  lvmFullDisk "$lvmFullDisk" '.lvmFullDisk = true')
        else
            updated_json=$(echo "$updated_json" | jq --arg  lvmFullDisk "$lvmFullDisk" '.lvmFullDisk = false')
        fi

        updated_json=$(echo "$updated_json" | jq --argjson  root_size "$root_size" '.rootSize = $root_size')

        if [ "$save_data" = "true" ]; then
            updated_json=$(echo "$updated_json" | jq --arg  save_data "$save_data" '.saveData = true')
        else
            updated_json=$(echo "$updated_json" | jq --arg  save_data "$save_data" '.saveData = false')
        fi

        updated_json=$(echo "$updated_json" | jq --argjson  swap_size "$swap_size" '.swapSize = $swap_size')
	echo ${updated_json} > $record_file
    fi
}

gen_experience 
