#!/bin/bash

#导入函数库
source $DI_INSTALL_TOOLS_DIR_ENV/scripts/function_include.sh

## 在备份之前处理后配置脚本的定制
copy_oem_first_boot

if [ -d "/target/root" ]; then  
    chmod 700 /target/root || warning "chmod 700 /target/root failed"
fi

if [ -d "/target/persistent/root" ]; then
    chmod 700 /target/persistent/root || warning "chmod 700 /target/persistent/root failed"
fi

