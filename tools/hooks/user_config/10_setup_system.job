#!/bin/bash

# 导入函数库
source $DI_INSTALL_TOOLS_DIR_ENV/scripts/function_include.sh

# 调用函数
## 设置键盘
setup_keyboard
## 设置系统的运行级别
setup_default_target
## 更新grub
#update_grub_local && update-initramfs -u

if is_community; then
    ## 复制替换DDM的服务
    cp -v /lib/systemd/system/replace-lightdm-with-ddm.service /etc/systemd/system/
fi