#!/bin/bash

#导入函数库
source $DI_INSTALL_TOOLS_DIR_ENV/scripts/function_include.sh

if is_ostree_system; then
    if [[ "x$(installer_get DI_IS_GHOST_MODE)" == "xtrue" ]]; then
        [ -f /uimg/localhost/usr/share/deepin-immutable-ctl/state/ostree-parent ] || error "No ostree-parent file found"
        base_commit_id=$(cat /uimg/localhost/usr/share/deepin-immutable-ctl/state/ostree-parent)
        base_commit="/ostree/deploy/deepin/deploy/$base_commit_id"
        info "base_commit=$base_commit"

        # 获取status.list的第一个commit id， 第一个是本次启动的commit
        orig_commit=$(cat /uimg/localhost/persistent/ostree/data/status.list | head -1)
        info "orig_commit_id=$orig_commit_id"

        ext_commit_id=$(echo $orig_commit | awk  -F. '{print $1}')

        if [ -z "$ext_commit_id" ]; then
            error "No commit ID found in status.list"
        fi
        ext_commit="/ostree/data/$ext_commit_id.0/checkout"

        info "ext_commit=$ext_commit"
        mount --make-private /target
       
        mkdir -vp /target/persistent/overlay/data || error "mkdir -p /target/persistent/overlay/data failed"

        rsync_file -aAHX --delete --exclude "/var-upper" --exclude "/var-work" /uimg/localhost/persistent/overlay/data/$orig_commit/ /target/persistent/overlay/data/$ext_commit_id.0 || error "rsync_file -aAHX --delete /uimg/localhost/persistent/overlay/data/$orig_commit/ /target/persistent/overlay/data/$ext_commit_id.0 failed"

        cp -vfr /uimg/localhost/persistent/ostree/data/$orig_commit/config /target/persistent/ostree/data/$ext_commit_id.0/config || error "cp -vfr /uimg/localhost/persistent/ostree/data/$orig_commit/config /target/persistent/ostree/data/$ext_commit_id.0/config failed"

        upper_layer_id=$(cat /target/persistent/ostree/data/$ext_commit_id.0/config | grep upper | awk  -F= '{print $2}')
        lowerdir_layer_id=$(cat /target/persistent/ostree/data/$ext_commit_id.0/config | grep lowerdir | awk  -F= '{print $2}')

        info "upper_layer_id=$upper_layer_id"
        info "lowerdir_layer_id=$lowerdir_layer_id"

        if [ -z "$upper_layer_id" ]; then
            error "No upper_layer_id found in config"
        else
            rsync_file -aAHX --delete /uimg/localhost/persistent/overlay/data/layer-$upper_layer_id /target/persistent/overlay/data/ || error "rsync_file -aAHX --delete /uimg/localhost/persistent/overlay/data/layer-$upper_layer_id /target/persistent/overlay/data/ failed"
        fi
        
        if [ -z "$lowerdir_layer_id" ] || [ "$lowerdir_layer_id" = "none" ]; then
            info "No lowerdir_layer_id found in config"
        else
            rsync_file -aAHX --delete /uimg/localhost/persistent/overlay/data/layer-$lowerdir_layer_id /target/persistent/overlay/data/ || error "rsync_file -aAHX --delete /uimg/localhost/persistent/overlay/data/layer-$lowerdir_layer_id /target/persistent/overlay/data/ failed"

        fi
        

        ostree_ext_mount $base_commit  $ext_commit

        mount_partitions
        setup_efi_parted
       

        if ! exist_home_part; then
            mkdir -p /target/persistent/home || error "mkdir -p /target/persistent/home failed"
            mount -v --bind /target/persistent/home /target/home || error "mount -v --bind /target/persistent/home /target/home failed"
        fi
        rsync_file -aAHX --delete /uimg/localhost/boot/ /target/boot || error "rsync_file -aAHX --delete /uimg/localhost/boot/ /target/boot failed"
        rsync_file -aAHX --delete  --exclude "/run" --exclude "/lock" /uimg/localhost/var/ /target/var || error "rsync_file -aAHX --delete /uimg/localhost/var/  /target/var failed"
        rsync_file -aAHX --delete /uimg/localhost/home/ /target/home || error "rsync_file -aAHX --delete /uimg/localhost/home/ /target/home failed"
    else
        bootID=$(echo /target/persistent/ostree/data/*/checkout | awk '{print $1}')
        grub_ostree="/${bootID#'/target/persistent'}"
        ostree=$(ostree_get_deploy /target $DI_REPO_BASE_NAME_ENV)
        mount --make-private /target

        ostree_ext_mount "$ostree" "$grub_ostree"

        mount_partitions
        setup_efi_parted
        # sync /var data
        unsquashfs_file "$DI_LIVE_DIR_ENV/live/filesystem-extra.squashfs"  /target/var  var/lib
        rm -fr /target/var/lib
        mv /target/var/var/lib /target/var
        rm -fr /target/var/var
        rsync_file -aAHX --delete --exclude "/run" --exclude "/lock" --exclude "/lib/dpkg" "/var/" "/target/var/" || warning "rsync_file /var failed"
        # ostree中/usr/local是/var/usrlocal的软链接，因此需要将/usr/local中的文件复制到/var/usrlocal
        mkdir -p /target/var/usrlocal
        rsync_file -aAHX --delete /usr/local/ /target/var/usrlocal/ || warning "rsync_file /usr/local/ failed"

        cp -vfr /boot/config-*  /boot/initrd.img-*  /boot/vmlinuz-*  /boot/System.map-* /target/boot || error "cp kernel failed"

        if [ -d /boot/usec-crypt ]; then
            cp -vfr /boot/usec-crypt /target/boot || warning "cp usec-crypt failed"
        fi
    fi
    chmod 700 /target/boot || warning "chmod 700 /target/boot failed"

fi
