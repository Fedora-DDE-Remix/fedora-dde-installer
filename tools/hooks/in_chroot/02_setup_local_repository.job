#!/bin/bash

#导入函数库
source $DI_INSTALL_TOOLS_DIR_ENV/scripts/function_include.sh


setup_apt_conf
setup_repo_sources

# 如果不是ostree系统，则删除/ostree/repo。 否则update-grub会因为grub.d/15_ostree报错
if ! is_ostree_system; then
    if [ -d /ostree/repo ]; then
        rm -rf /ostree/repo || error "Failed to remove /ostree/repo"
    fi
fi
