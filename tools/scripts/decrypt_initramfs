#!/bin/sh
PREREQ=""
prereqs()
{
    echo "$PREREQ"
}
case $1 in
    prereqs)
        prereqs
        exit 0
        ;;
esac
. initramfs-tools/hook-functions
echo "decrypt initramfs start..."
copy_exec /etc/deepin/disk_key/disk.key/iv.bin
copy_exec /etc/deepin/disk_key/disk.key/key.pub
copy_exec /etc/deepin/disk_key/disk.key/key.priv
copy_exec /etc/deepin/disk_key/disk.key/cipher.out
copy_exec /etc/deepin/disk_key/disk.key/cryptMode
echo "decrypt initramfs end!"
exit 0
